# Copia questo file in .env e inserisci i valori veri. Il file .env NON va in git.

APP_NAME="Pedro"
APP_DEBUG=false            # metti false in produzione

DB_HOST=db
DB_PORT=5432
DB_NAME=Pedro
DB_USER=Pedro
DB_PASSWORD=password

# Stampante di cucina
PRINTER_IP=192.168.1.50
PRINTER_PORT=9100

# --- Stampa in cucina (altri valori) ---
# network = stampante vera in rete | file = salva i biglietti in storage/prints/ (per provare) | off = non stampa
PRINTER_MODE=network
# 48 per carta da 80 mm, 32 per carta da 58 mm
PRINTER_COLUMNS=48
# cp858 (quasi tutte le stampanti) oppure cp1252 (se gli accenti escono sbagliati)
PRINTER_CHARSET=cp858
# true = taglia la carta a fine biglietto
PRINTER_CUT=true
